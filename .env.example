# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tatiana_db
POSTGRES_URL=postgresql://user:password@localhost:5432/tatiana_db

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Archive Access Token
# Generate a strong token for authentication
ARCHIVE_TOKEN=your_secure_token_here_generate_a_strong_one

# Optional: Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the actual .env file to git
# 2. Always use .env in .gitignore
# 3. On Railway, set environment variables in project settings
# 4. Generate strong tokens for ARCHIVE_TOKEN
# 5. Keep DATABASE_URL secret
